# Required: MongoDB connection string (MongoDB Atlas: Database → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Optional: database name (defaults to "ecoloop")
MONGODB_DB=ecoloop

# Optional: enables the admin portal (needed to verify collectors)
ADMIN_PASSWORD=

# Optional: derived from MONGODB_URI when unset
ADMIN_SESSION_TOKEN=
RATE_LIMIT_SALT=

# Optional: public contact email shown in the footer and privacy notice
NEXT_PUBLIC_CONTACT_EMAIL=
