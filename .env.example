# MongoDB connection string (MongoDB Atlas: Database → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name (optional, defaults to "ecoloop")
MONGODB_DB=ecoloop

# Admin portal
ADMIN_PASSWORD=
# Long random string, e.g. `openssl rand -hex 32`
ADMIN_SESSION_TOKEN=

# Random salt for rate-limit keys, e.g. `openssl rand -hex 32`
RATE_LIMIT_SALT=
