# Turso (libSQL) database — https://turso.tech
# Local development can use a file database: TURSO_DATABASE_URL=file:local.db
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# Admin portal
ADMIN_PASSWORD=
# Long random string, e.g. `openssl rand -hex 32`
ADMIN_SESSION_TOKEN=

# Random salt for rate-limit keys, e.g. `openssl rand -hex 32`
RATE_LIMIT_SALT=
